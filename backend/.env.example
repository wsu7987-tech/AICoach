APP_NAME=ai-coach-intent-router
ENVIRONMENT=development
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# Reserved for later tasks. Keep secrets out of this file and source them from deployment secrets.
DATABASE_URL=mysql+asyncmy://DB_USER:DB_PASSWORD@localhost:3306/ai_coach
# Used only by destructive MySQL integration tests. The database name must start
# with ai_coach_task002_test_ and must never point to a development database.
# MYSQL_TEST_DATABASE_URL=mysql+asyncmy://TEST_USER:TEST_PASSWORD@localhost:3306/ai_coach_task002_test_local
QWEN_API_KEY=

MAX_TEXT_CHARS=2000
MAX_CONTEXT_BYTES=16384
MAX_REQUEST_BODY_BYTES=1048576
MAX_EVAL_FILE_BYTES=52428800
MAX_EVAL_CASES=500
PROVIDER_QUEUE_WAIT_TIMEOUT=2.0

