{
  "name": "ai-coach-intent-router-frontend",
  "private": true,
  "version": "1.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "vue-tsc --noEmit",
    "format": "prettier --check src e2e index.html vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json package.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "element-plus": "^2.8.4",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "vue-tsc": "^2.1.10"
  }
}
