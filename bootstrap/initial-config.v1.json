  ],
  "slots": [
    {
      "name": "exercise",
      "zh": "动作",
      "description": "训练动作名称",
      "value_type": "string",
      "enum_group": "exercise",
      "enabled": true
    },
    {
      "name": "body_part",
      "zh": "身体部位",
      "description": "身体部位",
      "value_type": "enum",
      "enum_group": "body_part",
      "enabled": true
    },
    {
      "name": "device",
      "zh": "设备",
      "description": "设备名称或类型",
      "value_type": "string",
      "enum_group": "device",
      "enabled": true
    }
  ],
  "enums": {
    "exercise": [],
    "body_part": [
      {
        "canonical": "chest",
        "display": "胸部",
        "aliases": [
          "胸",
          "胸部",
          "胸肌"
        ]
      },
      {
        "canonical": "knee",
        "display": "膝盖",
        "aliases": [
          "膝盖",
          "膝",
          "膝关节"
        ]
      },
      {
        "canonical": "leg",
        "display": "腿部",
        "aliases": [
          "腿",
          "腿部",
          "下肢"
        ]
      }
    ],
    "device": []
  },
  "examples": [
    {
      "text": "今天练胸",
      "route": "training_business"
    },
    {
      "text": "我要做深蹲",
      "route": "training_business",
      "intent": "start_training"
    },
    {
      "text": "胸恢复了吗",
      "route": "information_query",
      "intent": "query_body_status"
    },
    {
      "text": "深蹲怎么做",
      "route": "sports_knowledge",
      "intent": "exercise_knowledge"
    },
    {
      "text": "膝盖疼，但我还想练腿",
      "route": "safety",
      "intent": "injury_pain"
    },
    {
      "text": "停下！不对不对",
      "route": "safety",
      "intent": "emergency_stop"
    },
    {
      "text": "帮我连一下手表",
      "route": "dialogue_device_control",
      "intent": "device_connect"
    },
    {
      "text": "声音再大一点",
      "route": "dialogue_device_control",
      "intent": "volume_up"
    },
    {
      "text": "你好",
      "route": "social_chat",
      "intent": "greeting"
    },
    {
      "text": "帮我订一张机票",
      "route": "unknown",
      "intent": "out_of_capability"
    }
  ],
  "prompt_template": {
    "system": "你是 AI Coach 的意图路由器。只根据当前已发布配置识别用户文本的业务路由、意图、槽位、风险与是否需要澄清。不得执行下游业务。训练业务只需要正确识别一级 route；训练业务缺参追问由现有规则系统处理。安全类一期仍由模型识别。",
    "include_examples": true,
    "rules": [
      "route 必须是当前 Route 配置中存在且已启用的 key",
      "可输出多个 intents，但需按置信度排序",
      "文本型 slot 只返回用户原话中明确出现的完整文本，枚举型 slot 由程序提取",
      "无法可靠分类时使用 unknown",
      "reason_summary 与 evidence 仅用于研发 Trace，不属于 Runtime Contract"
    ]
  }
}
