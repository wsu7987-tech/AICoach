{
  "schema_version": 1,
  "routes": [
    {
      "name": "training_business",
      "zh": "训练业务",
      "description": "用户希望开始、继续或执行训练相关业务",
      "enabled": true
    },
    {
      "name": "information_query",
      "zh": "信息查询",
      "description": "查询用户自身训练、身体状态、恢复、计划或历史信息",
      "enabled": true
    },
    {
      "name": "sports_knowledge",
      "zh": "运动知识咨询",
      "description": "询问动作、训练方法、运动知识或解释",
      "enabled": true
    },
    {
      "name": "safety",
      "zh": "身体风险/安全",
      "description": "疼痛、伤病、危险动作、紧急停止等安全相关表达",
      "enabled": true
    },
    {
      "name": "dialogue_device_control",
      "zh": "对话与设备控制",
      "description": "设备连接、控制、确认、取消等交互控制",
      "enabled": true
    },
    {
      "name": "social_chat",
      "zh": "社交/闲聊",
      "description": "问候、寒暄及非业务闲聊",
      "enabled": true
    },
    {
      "name": "unknown",
      "zh": "未知/不支持",
      "description": "无法可靠归入当前已支持业务范围",
      "enabled": true
    }
  ],
  "intents": [
    {
      "name": "start_training",
      "zh": "开始训练",
      "route": "training_business",
      "description": "泛指希望开始某项训练（无法归入下面具体训练意图时使用）",
      "enabled": true,
      "aliases": [
        "想开始训练"
      ]
    },
    {
      "name": "generate_single_course",
      "zh": "生成单次课程",
      "route": "training_business",
      "description": "希望生成/开始一次性训练课程",
      "enabled": true
    },
    {
      "name": "follow_plan",
      "zh": "按计划训练",
      "route": "training_business",
      "description": "按已有训练计划进行训练",
      "enabled": true
    },
    {
      "name": "create_long_term_plan",
      "zh": "制定长期计划",
      "route": "training_business",
      "description": "制定周/月等长期训练计划",
      "enabled": true
    },
    {
      "name": "adjust_schedule",
      "zh": "调整计划/日程",
      "route": "training_business",
      "description": "调整已有训练计划或日程",
      "enabled": true
    },
    {
      "name": "change_body_part",
      "zh": "更换训练部位",
      "route": "training_business",
      "description": "训练中或训练前更换训练部位",
      "enabled": true
    },
    {
      "name": "query_schedule",
      "zh": "查日程",
      "route": "information_query",
      "description": "查询训练日程安排",
      "enabled": true
    },
    {
      "name": "query_progress",
      "zh": "查进度",
      "route": "information_query",
      "description": "查询训练进度/完成情况",
      "enabled": true
    },
    {
      "name": "query_body_status",
      "zh": "查身体状态",
      "route": "information_query",
      "description": "查询恢复、疲劳或身体状态",
      "enabled": true,
      "aliases": [
        "查询身体状态"
      ]
    },
    {
      "name": "query_assessment",
      "zh": "查测评报告",
      "route": "information_query",
      "description": "查询体测/测评报告",
      "enabled": true
    },
    {
      "name": "exercise_knowledge",
      "zh": "动作/训练知识",
      "route": "sports_knowledge",
      "description": "询问动作方法、训练方法",
      "enabled": true,
      "aliases": [
        "动作训练知识"
      ]
    },
    {
      "name": "health_knowledge",
      "zh": "运动健康知识",
      "route": "sports_knowledge",
      "description": "询问运动健康、营养恢复等知识",
      "enabled": true
    },
    {
      "name": "device_usage_knowledge",
      "zh": "设备使用知识",
      "route": "sports_knowledge",
      "description": "询问设备如何使用",
      "enabled": true
    },
    {
      "name": "fatigue_consultation",
      "zh": "疲劳咨询",
      "route": "sports_knowledge",
      "description": "询问疲劳、酸痛是否影响训练（仅咨询，未表达明确疼痛/伤病）",
      "enabled": true,
      "mapping_note": "待产品确认：归 sports_knowledge 还是 safety（历史讨论中“腿有点酸还能练吗”曾期望 safety/fatigue）"
    },
    {
      "name": "injury_pain",
      "zh": "伤病/疼痛",
      "route": "safety",
      "description": "表达疼痛、伤病或继续训练风险",
      "enabled": true,
      "aliases": [
        "伤病或疼痛"
      ]
    },
    {
      "name": "emergency_stop",
      "zh": "紧急停止",
      "route": "safety",
      "description": "明确要求立即停止",
      "enabled": true
    },
    {
      "name": "training_safety_anomaly",
      "zh": "训练中安全异常",
      "route": "safety",
      "description": "训练中出现头晕、不适、动作危险等异常",
      "enabled": true
    },
    {
